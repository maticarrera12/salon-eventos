---
import { incluye } from '../data/content';
---

<section class="wrap" aria-labelledby="incluye-title">
  <div class="panel">
    <div class="panel__head">
      <span class="eyebrow"><span>02</span>Qué incluye</span>
      <h2 id="incluye-title" class="h2 panel__title">
        Un solo presupuesto. <span class="serif">Cero proveedores sueltos.</span>
      </h2>
      <p>Todo esto viene incluido desde el primer día. No tenés que salir a buscar nada por separado.</p>
    </div>
    <div class="items">
      {
        incluye.map((it, i) => (
          <div class="item" data-reveal style={`--i:${i % 2}`}>
            <span class="item__dot" style={`background:${it.dot}`}></span>
            <h3>{it.titulo}</h3>
            <p>{it.texto}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .panel {
    background: var(--wine);
    color: var(--bg);
    border-radius: clamp(28px, 3.5vw, 48px);
    padding: clamp(28px, 5vw, 72px);
    display: flex;
    flex-wrap: wrap;
    gap: 48px clamp(32px, 5vw, 80px);
  }
  .panel__head {
    flex: 4 1 300px;
    min-width: 0;
  }
  .panel__head .eyebrow {
    color: var(--coral);
  }
  .panel__head .eyebrow span {
    background: rgba(194, 208, 118, 0.18);
  }
  .panel__title {
    margin: 16px 0 0;
  }
  .panel__title .serif {
    color: var(--coral);
  }
  .panel__head > p {
    margin-top: 24px;
    color: var(--on-dark);
    max-width: 34ch;
  }
  .items {
    flex: 7 1 460px;
    min-width: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 12px;
  }
  .item {
    background: rgba(255, 248, 240, 0.07);
    border-radius: 24px;
    padding: 24px;
  }
  .item__dot {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }
  h3 {
    margin-top: 14px;
    font-family: var(--display);
    font-weight: 700;
    font-size: 21px;
    letter-spacing: -0.01em;
  }
  .item p {
    margin-top: 8px;
    color: var(--on-dark);
    font-size: 15px;
    text-wrap: pretty;
  }
</style>
