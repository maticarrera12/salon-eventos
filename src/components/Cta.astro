---
import { waLink } from '../data/content';
---

<section class="cta-wrap" aria-labelledby="cta-title" id="contacto">
  <div class="cta" data-reveal>
    <h2 id="cta-title" class="cta__title">¿Tenés una fecha <span class="serif">en mente?</span></h2>
    <div class="cta__side">
      <p>Los sábados de primavera se reservan con seis a ocho meses de anticipación. Consultá antes de que se ocupe.</p>
      <a class="pill cta__main" href="#contacto">
        Consultá tu fecha <span class="pill__arrow cta__arrow" aria-hidden="true">→</span>
      </a>
      <a class="cta__wa" href={waLink} target="_blank" rel="noopener">Escribinos por WhatsApp <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>

<style>
  .cta-wrap {
    max-width: calc(1360px + 2 * var(--pad-x));
    margin: 0 auto;
    padding: var(--section) var(--pad-x) var(--pad-x);
  }
  .cta {
    background: #c2d076;
    color: var(--wine);
    border-radius: clamp(28px, 3.5vw, 48px);
    padding: clamp(32px, 6vw, 88px);
    display: flex;
    flex-wrap: wrap;
    gap: 40px clamp(32px, 5vw, 80px);
    align-items: flex-end;
  }
  .cta__title {
    flex: 7 1 480px;
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(52px, 7.6vw, 120px);
    line-height: 0.92;
    letter-spacing: -0.045em;
  }
  .cta__side {
    flex: 4 1 280px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .cta__side p {
    margin: 0 0 8px;
    max-width: 34ch;
  }
  .cta__main {
    justify-content: space-between;
    background: var(--wine);
    color: #fff;
    padding: 16px 16px 16px 24px;
  }
  .cta__arrow {
    background: var(--accent);
    color: var(--wine);
  }
  .cta__wa {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #fff;
    color: var(--wine);
    padding: 20px 24px;
    border-radius: 999px;
    font-weight: 600;
    transition:
      background-color 160ms ease,
      transform 160ms var(--ease-out);
  }
  .cta__wa:active {
    transform: scale(0.97);
  }
  @media (hover: hover) and (pointer: fine) {
    .cta__main:hover {
      background: var(--wine-hover);
      color: #fff;
    }
    .cta__wa:hover {
      background: var(--bg);
      color: var(--wine);
    }
  }
</style>
