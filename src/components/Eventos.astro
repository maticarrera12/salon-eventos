---
import { eventos } from '../data/content';
---

<section class="wrap" aria-labelledby="eventos-title" id="eventos">
  <div class="head">
    <div data-reveal>
      <span class="eyebrow"><span>01</span>Eventos</span>
      <h2 id="eventos-title" class="h2 head__title">
        Un salón, <span class="serif">cinco fiestas distintas.</span>
      </h2>
    </div>
    <p class="head__aside" data-reveal style="--i:1">
      Cambiamos las mesas, la luz y hasta por dónde entran los invitados según lo que festejes.
    </p>
  </div>

  <div class="grid">
    {
      eventos.map((ev, i) => (
        <a class="card" href="#galeria" data-reveal style={`--i:${i}`}>
          <div class="card__photo" style={`background:${ev.bg}`}>
            <img src={ev.img} alt={ev.alt} width="640" height="800" loading="lazy" decoding="async" />
            <span class="card__n">{ev.n}</span>
          </div>
          <div class="card__body">
            <h3>{ev.nombre}</h3>
            <p>{ev.linea}</p>
          </div>
        </a>
      ))
    }
  </div>
</section>

<style>
  .head {
    display: flex;
    flex-wrap: wrap;
    gap: 20px 40px;
    justify-content: space-between;
    align-items: flex-end;
    padding: 0 clamp(8px, 1.5vw, 16px);
  }
  .head__title {
    margin: 16px 0 0;
    max-width: 15ch;
  }
  .head__aside {
    max-width: 38ch;
    color: var(--muted);
  }
  .grid {
    margin-top: 40px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr));
    gap: var(--gap);
  }
  /* Five events: one row on wide screens instead of four plus an orphan. */
  @media (min-width: 1100px) {
    .grid {
      grid-template-columns: repeat(5, 1fr);
    }
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .card__photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms var(--ease-out);
  }
  .card__photo {
    aspect-ratio: 4 / 5;
    border-radius: 28px;
    position: relative;
    overflow: hidden;
  }
  .card__n {
    position: absolute;
    left: 16px;
    top: 16px;
    background: #fff;
    border-radius: 999px;
    padding: 6px 12px;
    font-size: 12px;
    font-weight: 600;
  }
  .card__body {
    padding: 0 6px;
  }
  h3 {
    font-family: var(--display);
    font-weight: 700;
    font-size: 24px;
    letter-spacing: -0.02em;
  }
  .card__body p {
    margin-top: 6px;
    font-size: 15px;
    color: var(--muted);
    text-wrap: pretty;
  }
  @media (hover: hover) and (pointer: fine) {
    .card {
      transition: transform 220ms var(--ease-out);
    }
    .card:hover {
      transform: translateY(-4px);
    }
    .card:hover .card__photo img {
      transform: scale(1.04);
    }
  }
</style>
